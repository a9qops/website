# Prisma 7 Database Configuration
DATABASE_URL="postgres://user:password@localhost:5432/nine_portfolio"
SHADOW_DATABASE_URL="postgres://user:password@localhost:5432/nine_portfolio_shadow"

# Authentication
# Must be a secure random string in production
JWT_SECRET="generate-a-secure-secret-for-production"

# Admin Bootstrap
# Only used during initial database seed, not evaluated at runtime
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="securepassword"
